{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "design/**": true
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)TODO.md' ':(exclude)docs' ':(exclude)tests' ':(exclude)**/*.md'",
  "functions": {
    "app/wsgi.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,docs/**,db/**,.claude/**,features/forecast/data/models/stages/**,features/forecast/data/models/stages_candidates/**,features/forecast/data/forecast_history/**,features/forecast/data/raw/openmeteo_prev_runs_*.csv,features/forecast/data/raw/openmeteo_hist_forecast_*.csv}"
    }
  }
}
