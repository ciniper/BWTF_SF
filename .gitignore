.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/
data/*.json
!data/.gitkeep
token.txt

# Forecast feature: large, regenerable training data.
# Trained models (features/forecast/data/models/*.pkl + *.json) ARE committed
# so /forecast works on a fresh clone.
features/forecast/data/raw/
features/forecast/data/processed/
!features/forecast/data/raw/.gitkeep
!features/forecast/data/processed/.gitkeep

# Local secrets (Supabase service key etc.) — never commit
.env
